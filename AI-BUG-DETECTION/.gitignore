#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tosca/
.pytest_cache/
.mypy_cache/
.noserc
.jax_cache/

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# SQLite databases
*.db
*.sqlite3

# Node modules
node_modules/
/dist
/build
.DS_Store

# Local env files
.env.local
.env.development.local
.env.test.local
.env.production.local

